generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("PATIENT")
  assignedClinicianId String?
  assignedClinician   User?  @relation("ClinicianPatientPanel", fields: [assignedClinicianId], references: [id], onDelete: SetNull)
  assignedPatients    User[] @relation("ClinicianPatientPanel")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientEpisodes WoundEpisode[] @relation("PatientEpisodes")
  clinicianReviews ClinicianReview[] @relation("ClinicianReviews")
  notifications Notification[]
}

model WoundEpisode {
  id            String      @id @default(cuid())
  patientId     String
  patient       User        @relation("PatientEpisodes", fields: [patientId], references: [id], onDelete: Cascade)
  procedureLabel String
  surgeryDate   DateTime
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  checkIns CheckIn[]
}

model CheckIn {
  id                String   @id @default(cuid())
  woundEpisodeId    String
  woundEpisode      WoundEpisode @relation(fields: [woundEpisodeId], references: [id], onDelete: Cascade)
  capturedAt        DateTime @default(now())
  imageUrl          String?
  imageQualityStatus String   @default("GOOD")
  painScore         Int      @default(0)
  redness           Boolean  @default(false)
  swelling          Boolean  @default(false)
  drainage          Boolean  @default(false)
  fever             Boolean  @default(false)
  temperature       Float?
  notes             String?
  aiConcernLevel    String?
  aiScore           Float?
  modelVersion      String?
  status            String   @default("SUBMITTED")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  clinicianReview ClinicianReview?
}

model ClinicianReview {
  id              String   @id @default(cuid())
  checkInId       String   @unique
  checkIn         CheckIn  @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  clinicianId     String
  clinician       User     @relation("ClinicianReviews", fields: [clinicianId], references: [id], onDelete: Cascade)
  note            String?
  action          String   @default("ROUTINE_FOLLOW_UP")
  nextCheckInDate DateTime?
  reviewedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Notification {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type               String
  title              String
  message            String
  relatedEntityType  String
  relatedEntityId    String
  metadata           String?
  readAt             DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId, readAt])
  @@index([relatedEntityType, relatedEntityId])
}